---
// HomePostFeed.astro - Robust Editorial & Bento Grid with Randomizer (Pure Astro + Client Script)
interface PostItem {
  id: string;
  title: string;
  excerpt: string;
  date: string;
  category: string;
  image: string;
  author: string;
}

interface Props {
  posts: PostItem[];
}

const { posts } = Astro.props;
const featuredPost = posts && posts.length > 0 ? posts[0] : null;
const standardGridPosts = posts && posts.length > 1 ? posts.slice(1) : [];

// Mathematically balanced Bento puzzle for 7 posts (Exact 12 cells = 4 rows x 3 cols, zero empty gaps)
const bentoSlots = [
  { type: "hero", col: "md:col-span-2", row: "md:row-span-2" }, // Row 1-2, Col 1-2 (4 cells)
  { type: "compact", col: "md:col-span-1", row: "md:row-span-1" }, // Row 1, Col 3 (1 cell)
  { type: "compact", col: "md:col-span-1", row: "md:row-span-1" }, // Row 2, Col 3 (1 cell)
  { type: "wide", col: "md:col-span-2", row: "md:row-span-1" }, // Row 3, Col 1-2 (2 cells)
  { type: "compact", col: "md:col-span-1", row: "md:row-span-1" }, // Row 3, Col 3 (1 cell)
  { type: "compact", col: "md:col-span-1", row: "md:row-span-1" }, // Row 4, Col 1 (1 cell)
  { type: "wide", col: "md:col-span-2", row: "md:row-span-1" }, // Row 4, Col 2-3 (2 cells)
];
---

<div>
  <!-- Section Header Controls -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 md:mb-10 pb-4 border-b border-border gap-4">
    <div>
      <span class="text-xs uppercase tracking-widest text-primary font-bold block mb-1.5">
        Journal & Essays
      </span>
      <h2 class="text-2xl md:text-3xl font-extrabold text-text tracking-tight m-0">
        บันทึกล่าสุด
      </h2>
    </div>

    <!-- View Toggle & Shuffle Action Group -->
    <div class="flex items-center gap-2.5 self-start sm:self-auto flex-wrap">
      <!-- Mode Switcher Pill -->
      <div class="inline-flex p-1 bg-surface-subtle rounded-full border border-border">
        <button
          type="button"
          id="feed-btn-standard"
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 bg-surface text-text shadow-xs border border-border/80"
          title="Standard Editorial View"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="7" height="7" x="3" y="3" rx="1" />
            <rect width="7" height="7" x="14" y="3" rx="1" />
            <rect width="7" height="7" x="14" y="14" rx="1" />
            <rect width="7" height="7" x="3" y="14" rx="1" />
          </svg>
          <span>มาตรฐาน</span>
        </button>

        <button
          type="button"
          id="feed-btn-bento"
          class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 text-text-muted hover:text-text"
          title="Interactive Bento Grid View"
        >
          <span>🍱</span>
          <span>Bento Grid</span>
        </button>
      </div>

      <!-- Shuffle Button (Visible when Bento is active) -->
      <button
        type="button"
        id="feed-btn-shuffle"
        class="hidden px-3.5 py-1.5 rounded-full bg-surface border border-border text-xs font-semibold text-text hover:border-primary/50 hover:text-primary transition-all shadow-xs cursor-pointer items-center gap-1.5"
        title="Randomize Bento Grid Layout"
      >
        <span id="feed-shuffle-icon" class="inline-block transition-transform duration-500">
          🎲
        </span>
        <span>สลับ Bento</span>
      </button>

      <!-- View All link -->
      <a
        href="/blog"
        class="text-xs font-semibold text-text-muted hover:text-primary transition-colors flex items-center gap-1 group no-underline ml-1"
      >
        <span>ดูทั้งหมด</span>
        <span class="transition-transform duration-200 group-hover:translate-x-1">
          →
        </span>
      </a>
    </div>
  </div>

  {
    !posts || posts.length === 0 ? (
      <div class="card-editorial p-16 text-center text-base text-text-muted mb-20">
        <div class="hanko-stamp mb-3 text-sm">栞</div>
        <p class="m-0 font-medium">ยังไม่มีบทความใหม่ในขณะนี้ แวะกลับมาอ่านใหม่เร็วๆ นี้นะครับ</p>
      </div>
    ) : (
      <div>
        {/* ──────── 1. STANDARD EDITORIAL VIEW ──────── */}
        <div id="feed-standard-view" class="transition-all duration-300">
          {featuredPost && (
            <article class="group relative card-editorial overflow-hidden mb-10 md:mb-14 grid grid-cols-1 lg:grid-cols-12">
              <div class="bookmark-ribbon" title="Bookmark">栞</div>

              <a
                href={`/blog/${featuredPost.id}`}
                class="lg:col-span-7 block relative aspect-16/10 lg:aspect-auto min-h-[260px] sm:min-h-[340px] lg:min-h-[400px] overflow-hidden bg-surface-subtle cursor-pointer"
              >
                <img
                  src={featuredPost.image}
                  alt={featuredPost.title}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="eager"
                  onerror="this.onerror=null;this.src='https://placehold.co/600x400/1a1a1a/F63049?text=Shiori+Blog';"
                />
                <div class="absolute top-4 left-4 bg-surface/95 backdrop-blur-xs px-3 py-1 rounded-md border border-border flex items-center gap-2 shadow-xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                  <span class="text-[0.7rem] font-bold tracking-wider text-text uppercase">
                    Featured • No. 01
                  </span>
                </div>
              </a>

              <div class="lg:col-span-5 p-7 sm:p-9 lg:p-10 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 mb-4">
                    <span class="paper-tag">{featuredPost.category}</span>
                    <span class="text-xs text-text-muted font-medium">{featuredPost.date}</span>
                  </div>
                  <h3 class="text-2xl sm:text-3xl font-bold mb-4 leading-snug">
                    <a
                      href={`/blog/${featuredPost.id}`}
                      class="text-text no-underline transition-colors duration-300 group-hover:text-primary"
                    >
                      {featuredPost.title}
                    </a>
                  </h3>
                  <p class="text-text-muted text-[0.95rem] leading-relaxed line-clamp-3 md:line-clamp-4 mb-6">
                    {featuredPost.excerpt}
                  </p>
                </div>

                <div class="pt-6 border-t border-border flex items-center justify-between">
                  <div class="flex items-center gap-2 text-xs font-semibold text-text-muted">
                    <span class="hanko-stamp">栞</span>
                    <span>{featuredPost.author}</span>
                  </div>
                  <a
                    href={`/blog/${featuredPost.id}`}
                    class="text-xs font-bold uppercase tracking-wider text-primary flex items-center gap-1 group-hover:translate-x-0.5 transition-transform no-underline"
                  >
                    <span>เปิดอ่านบันทึก</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          )}

          {standardGridPosts.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7 md:gap-8 mb-20">
              {standardGridPosts.map((post, index) => {
                const issueNum = String(index + 2).padStart(2, "0");
                return (
                  <article class="group relative card-editorial overflow-hidden flex flex-col">
                    <div class="bookmark-ribbon" title="Bookmark">栞</div>

                    <a
                      href={`/blog/${post.id}`}
                      class="block aspect-16/10 overflow-hidden bg-surface-subtle cursor-pointer relative"
                    >
                      <img
                        src={post.image}
                        alt={post.title}
                        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                        loading="lazy"
                        onerror="this.onerror=null;this.src='https://placehold.co/600x400/1a1a1a/F63049?text=Shiori+Blog';"
                      />
                      <div class="absolute top-3 left-3 bg-surface/90 backdrop-blur-xs px-2.5 py-0.5 rounded border border-border text-[0.65rem] font-bold tracking-wider text-text-muted">
                        No. {issueNum}
                      </div>
                    </a>

                    <div class="p-6 md:p-7 flex flex-col flex-1">
                      <div class="flex items-center gap-2.5 mb-3">
                        <span class="paper-tag text-[0.7rem] px-2 py-0.5">{post.category}</span>
                        <span class="text-xs text-text-muted font-medium">{post.date}</span>
                      </div>

                      <h3 class="text-lg md:text-xl font-bold mb-3 leading-snug">
                        <a
                          href={`/blog/${post.id}`}
                          class="text-text no-underline transition-colors duration-300 group-hover:text-primary line-clamp-2"
                        >
                          {post.title}
                        </a>
                      </h3>

                      <p class="text-text-muted text-sm leading-relaxed line-clamp-2 mb-6 mt-auto">
                        {post.excerpt}
                      </p>

                      <div class="pt-4 border-t border-border flex justify-between items-center text-xs text-text-muted">
                        <span class="flex items-center gap-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                          {post.author}
                        </span>
                        <a
                          href={`/blog/${post.id}`}
                          class="font-semibold text-primary group-hover:translate-x-0.5 transition-transform flex items-center gap-1 no-underline"
                        >
                          อ่านต่อ →
                        </a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          )}
        </div>

        {/* ──────── 2. ADAPTIVE BENTO GRID VIEW (Hidden by default) ──────── */}
        <div
          id="feed-bento-view"
          class="hidden grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 auto-rows-[220px] md:auto-rows-[240px] mb-20 transition-all duration-300 grid-flow-dense"
        >
          {posts.map((post, index) => {
            const slot = bentoSlots[index % bentoSlots.length];

            if (slot.type === "hero") {
              return (
                <article
                  class={`bento-card group relative card-editorial overflow-hidden rounded-2xl flex flex-col justify-end p-6 md:p-8 ${slot.col} ${slot.row} min-h-[340px] shadow-sm transition-all duration-300`}
                  data-index={index}
                >
                  <div class="bookmark-ribbon" title="Bookmark">栞</div>
                  <img
                    src={post.image}
                    alt={post.title}
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                    onerror="this.onerror=null;this.src='https://placehold.co/600x400/1a1a1a/F63049?text=Shiori+Blog';"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20 z-[1]"></div>
                  <div class="absolute top-5 left-5 z-10 flex items-center gap-2">
                    <span class="px-3 py-1 rounded-full bg-primary/90 backdrop-blur-xs text-white text-[0.7rem] font-bold uppercase tracking-wider shadow-xs">
                      {post.category}
                    </span>
                    <span class="px-2.5 py-1 rounded-full bg-black/50 backdrop-blur-xs text-white/80 text-[0.65rem] font-medium border border-white/10">
                      {post.date}
                    </span>
                  </div>
                  <div class="relative z-10 text-white">
                    <h3 class="text-xl sm:text-2xl md:text-3xl font-black mb-3 leading-snug drop-shadow-xs">
                      <a href={`/blog/${post.id}`} class="text-white no-underline hover:text-white/85 transition-colors">
                        {post.title}
                      </a>
                    </h3>
                    <p class="text-white/80 text-xs sm:text-sm line-clamp-2 md:line-clamp-3 mb-4 leading-relaxed font-normal">
                      {post.excerpt}
                    </p>
                    <div class="flex items-center justify-between pt-3 border-t border-white/15 text-xs text-white/70">
                      <span class="flex items-center gap-1.5 font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                        {post.author}
                      </span>
                      <a href={`/blog/${post.id}`} class="font-bold text-white flex items-center gap-1 no-underline group-hover:translate-x-1 transition-transform">
                        <span>อ่านบันทึก</span>
                        <span>→</span>
                      </a>
                    </div>
                  </div>
                </article>
              );
            }

            if (slot.type === "wide") {
              return (
                <article
                  class={`bento-card group relative card-editorial overflow-hidden rounded-2xl grid grid-cols-1 sm:grid-cols-12 ${slot.col} ${slot.row} shadow-xs transition-all duration-300`}
                  data-index={index}
                >
                  <div class="bookmark-ribbon" title="Bookmark">栞</div>
                  <a href={`/blog/${post.id}`} class="sm:col-span-5 relative block overflow-hidden bg-surface-subtle min-h-[160px] sm:min-h-full">
                    <img
                      src={post.image}
                      alt={post.title}
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                      loading="lazy"
                      onerror="this.onerror=null;this.src='https://placehold.co/600x400/1a1a1a/F63049?text=Shiori+Blog';"
                    />
                  </a>
                  <div class="sm:col-span-7 p-5 md:p-6 flex flex-col justify-between">
                    <div>
                      <div class="flex items-center gap-2 mb-2">
                        <span class="paper-tag text-[0.65rem] px-2 py-0.5">{post.category}</span>
                        <span class="text-[0.7rem] text-text-muted font-medium">{post.date}</span>
                      </div>
                      <h3 class="text-base sm:text-lg font-bold leading-snug mb-2">
                        <a href={`/blog/${post.id}`} class="text-text no-underline hover:text-primary transition-colors line-clamp-2">
                          {post.title}
                        </a>
                      </h3>
                      <p class="text-text-muted text-xs leading-relaxed line-clamp-2 hidden sm:block">
                        {post.excerpt}
                      </p>
                    </div>
                    <div class="pt-3 border-t border-border flex items-center justify-between text-xs text-text-muted">
                      <span class="text-[0.7rem] truncate">{post.author}</span>
                      <a href={`/blog/${post.id}`} class="font-bold text-primary flex items-center gap-1 no-underline group-hover:translate-x-0.5 transition-transform">
                        อ่านต่อ →
                      </a>
                    </div>
                  </div>
                </article>
              );
            }

            if (slot.type === "tall") {
              return (
                <article
                  class={`bento-card group relative card-editorial overflow-hidden rounded-2xl flex flex-col ${slot.col} ${slot.row} shadow-xs transition-all duration-300`}
                  data-index={index}
                >
                  <div class="bookmark-ribbon" title="Bookmark">栞</div>
                  <a href={`/blog/${post.id}`} class="block relative h-[50%] overflow-hidden bg-surface-subtle shrink-0">
                    <img
                      src={post.image}
                      alt={post.title}
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                      loading="lazy"
                      onerror="this.onerror=null;this.src='https://placehold.co/600x400/1a1a1a/F63049?text=Shiori+Blog';"
                    />
                    <div class="absolute top-3 left-3">
                      <span class="paper-tag text-[0.65rem] px-2 py-0.5 bg-surface/90">{post.category}</span>
                    </div>
                  </a>
                  <div class="p-5 flex flex-col justify-between flex-1">
                    <div>
                      <span class="text-[0.7rem] text-text-muted font-medium block mb-1">{post.date}</span>
                      <h3 class="text-base font-bold leading-snug mb-2">
                        <a href={`/blog/${post.id}`} class="text-text no-underline hover:text-primary transition-colors line-clamp-3">
                          {post.title}
                        </a>
                      </h3>
                      <p class="text-text-muted text-xs leading-relaxed line-clamp-3">
                        {post.excerpt}
                      </p>
                    </div>
                    <div class="pt-3 border-t border-border flex items-center justify-between text-xs text-text-muted">
                      <span class="text-[0.7rem]">{post.author}</span>
                      <a href={`/blog/${post.id}`} class="font-bold text-primary flex items-center gap-1 no-underline group-hover:translate-x-0.5 transition-transform">
                        อ่านต่อ →
                      </a>
                    </div>
                  </div>
                </article>
              );
            }

            // Compact
            return (
              <article
                class={`bento-card group relative card-editorial overflow-hidden rounded-2xl p-4 sm:p-5 flex flex-col justify-between ${slot.col} ${slot.row} shadow-xs transition-all duration-300`}
                data-index={index}
              >
                <div class="bookmark-ribbon" title="Bookmark">栞</div>
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="paper-tag text-[0.65rem] px-2 py-0.5">{post.category}</span>
                    <span class="text-[0.7rem] text-text-muted font-medium">{post.date}</span>
                  </div>

                  <div class="flex gap-3 items-start my-2">
                    <a href={`/blog/${post.id}`} class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden bg-surface-subtle shrink-0 block relative">
                      <img
                        src={post.image}
                        alt={post.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                        loading="lazy"
                        onerror="this.onerror=null;this.src='https://placehold.co/600x400/1a1a1a/F63049?text=Shiori+Blog';"
                      />
                    </a>
                    <h3 class="text-sm sm:text-base font-bold leading-snug m-0 flex-1">
                      <a href={`/blog/${post.id}`} class="text-text no-underline hover:text-primary transition-colors line-clamp-3">
                        {post.title}
                      </a>
                    </h3>
                  </div>
                </div>

                <div class="pt-2 border-t border-border flex items-center justify-between text-xs text-text-muted">
                  <span class="text-[0.7rem] truncate">{post.author}</span>
                  <a href={`/blog/${post.id}`} class="font-bold text-primary flex items-center gap-1 no-underline group-hover:translate-x-0.5 transition-transform">
                    อ่าน →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    )
  }
</div>

<script is:inline>
  function setupFeedSwitcher() {
    const btnStandard = document.getElementById("feed-btn-standard");
    const btnBento = document.getElementById("feed-btn-bento");
    const btnShuffle = document.getElementById("feed-btn-shuffle");
    const shuffleIcon = document.getElementById("feed-shuffle-icon");
    const standardView = document.getElementById("feed-standard-view");
    const bentoView = document.getElementById("feed-bento-view");

    if (!btnStandard || !btnBento || !standardView || !bentoView) return;

    let isBentoActive = false;

    // Bento slot permutations for randomizing (All presets mathematically sum to exactly 12 cells: 4 rows x 3 cols with zero gaps)
    const presetClasses = [
      // Preset 1: Hero Top-Left
      [
        "md:col-span-2 md:row-span-2",
        "md:col-span-1 md:row-span-1",
        "md:col-span-1 md:row-span-1",
        "md:col-span-2 md:row-span-1",
        "md:col-span-1 md:row-span-1",
        "md:col-span-1 md:row-span-1",
        "md:col-span-2 md:row-span-1",
      ],
      // Preset 2: Hero Top-Right
      [
        "md:col-span-1 md:row-span-1",
        "md:col-span-1 md:row-span-1",
        "md:col-span-2 md:row-span-2",
        "md:col-span-1 md:row-span-1",
        "md:col-span-2 md:row-span-1",
        "md:col-span-2 md:row-span-1",
        "md:col-span-1 md:row-span-1",
      ],
      // Preset 3: Wide Top + Hero Center
      [
        "md:col-span-2 md:row-span-1",
        "md:col-span-1 md:row-span-1",
        "md:col-span-2 md:row-span-2",
        "md:col-span-1 md:row-span-2",
        "md:col-span-1 md:row-span-1",
        "md:col-span-2 md:row-span-1",
        "md:col-span-1 md:row-span-1",
      ],
      // Preset 4: Tall Left + Hero Right
      [
        "md:col-span-1 md:row-span-1",
        "md:col-span-2 md:row-span-1",
        "md:col-span-1 md:row-span-2",
        "md:col-span-2 md:row-span-2",
        "md:col-span-2 md:row-span-1",
        "md:col-span-1 md:row-span-1",
        "md:col-span-1 md:row-span-1",
      ],
    ];

    let currentPresetIdx = 0;

    function activateStandard() {
      isBentoActive = false;
      standardView.classList.remove("hidden");
      bentoView.classList.add("hidden");
      bentoView.classList.remove("grid");
      bentoView.classList.remove("grid-flow-dense");

      // Button styles
      btnStandard.className = "px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 bg-surface text-text shadow-xs border border-border/80";
      btnBento.className = "px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 text-text-muted hover:text-text";

      if (btnShuffle) {
        btnShuffle.classList.add("hidden");
        btnShuffle.classList.remove("inline-flex");
      }
    }

    function activateBento() {
      isBentoActive = true;
      standardView.classList.add("hidden");
      bentoView.classList.remove("hidden");
      bentoView.classList.add("grid");
      bentoView.classList.add("grid-flow-dense");

      // Button styles
      btnStandard.className = "px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 text-text-muted hover:text-text";
      btnBento.className = "px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5 bg-primary text-white shadow-xs";

      if (btnShuffle) {
        btnShuffle.classList.remove("hidden");
        btnShuffle.classList.add("inline-flex");
      }
    }

    function shuffleBento() {
      if (!isBentoActive) return;

      if (shuffleIcon) {
        shuffleIcon.classList.add("rotate-180");
        setTimeout(() => shuffleIcon.classList.remove("rotate-180"), 500);
      }

      bentoView.style.opacity = "0.3";
      bentoView.style.transform = "scale(0.99)";

      setTimeout(() => {
        currentPresetIdx = (currentPresetIdx + 1) % presetClasses.length;
        const currentClasses = presetClasses[currentPresetIdx];
        const cards = Array.from(bentoView.querySelectorAll(".bento-card"));

        // Shuffle DOM order
        const shuffledCards = [...cards].sort(() => Math.random() - 0.5);
        shuffledCards.forEach((card, idx) => {
          // Remove old span classes
          card.classList.remove(
            "md:col-span-1", "md:col-span-2", "md:col-span-3",
            "md:row-span-1", "md:row-span-2"
          );
          // Add new span classes
          const newSpans = currentClasses[idx % currentClasses.length].split(" ");
          newSpans.forEach((cls) => card.classList.add(cls));
          // Append back to reorder in DOM
          bentoView.appendChild(card);
        });

        bentoView.style.opacity = "1";
        bentoView.style.transform = "scale(1)";
      }, 200);
    }

    btnStandard.onclick = activateStandard;
    btnBento.onclick = activateBento;
    if (btnShuffle) btnShuffle.onclick = shuffleBento;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFeedSwitcher);
  } else {
    setupFeedSwitcher();
  }
  document.addEventListener("astro:page-load", setupFeedSwitcher);
</script>
