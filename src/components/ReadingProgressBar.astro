---
/**
 * ReadingProgressBar.astro
 * Sleek, top-mounted reading progress bar with Japanese editorial aesthetic.
 * Automatically tracks scroll progress through the article content.
 */
---

<div
  id="reading-progress-container"
  class="fixed top-0 left-0 right-0 z-[1001] h-[3.5px] bg-emerald-500/15 pointer-events-none transition-opacity duration-300 opacity-0"
  aria-hidden="true"
>
  <div
    id="reading-progress-bar"
    class="h-full w-0 bg-gradient-to-r from-emerald-600 via-emerald-400 to-teal-300 shadow-[0_0_14px_rgba(16,185,129,0.8)] transition-[width] duration-75 ease-out"
  ></div>
</div>

<script is:inline>
  (function () {
    let scrollHandler = null;

    function initReadingProgress() {
      const container = document.getElementById("reading-progress-container");
      const bar = document.getElementById("reading-progress-bar");
      const article = document.querySelector(".card-editorial") || document.querySelector("article");

      if (!container || !bar || !article) return;

      if (scrollHandler) {
        window.removeEventListener("scroll", scrollHandler);
      }

      scrollHandler = () => {
        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleHeight = rect.height;
        const windowHeight = window.innerHeight;
        const currentScroll = window.scrollY;

        // Calculate progress within article boundaries
        const totalScrollable = articleHeight - windowHeight;
        if (totalScrollable <= 0) {
          bar.style.width = "100%";
          container.classList.remove("opacity-0");
          container.classList.add("opacity-100");
          return;
        }

        const distanceScrolled = currentScroll - articleTop;
        const progress = Math.min(Math.max(0, (distanceScrolled / totalScrollable) * 100), 100);

        bar.style.width = progress + "%";

        // Show bar only after user starts reading past the article header
        if (distanceScrolled > -100) {
          container.classList.remove("opacity-0");
          container.classList.add("opacity-100");
        } else {
          container.classList.add("opacity-0");
          container.classList.remove("opacity-100");
        }
      };

      window.addEventListener("scroll", scrollHandler, { passive: true });
      scrollHandler(); // Initial calculation
    }

    // Attach to Astro page load lifecycle for ViewTransitions support
    document.addEventListener("astro:page-load", initReadingProgress);
  })();
</script>
