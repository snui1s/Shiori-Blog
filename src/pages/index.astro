---
import Layout from "../layouts/Layout.astro";
import { db, Post, desc } from "astro:db";
import { getOptimizedImageUrl } from "../lib/images";

const rawPosts = await db
  .select()
  .from(Post)
  .orderBy(desc(Post.createdAt))
  .limit(7);

const posts = rawPosts.map((post, index) => {
  const imageUrl =
    post.imageUrl ||
    "https://placehold.co/600x400/1a1a1a/F63049?text=Image+is+Sleeping...";
  return {
    id: post.slug,
    title: post.title,
    excerpt: post.excerpt || "",
    date: new Date(post.createdAt).toLocaleDateString("th-TH", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }),
    category: post.category,
    image: getOptimizedImageUrl(imageUrl, 800),
    author: post.author,
  };
});

import HomePostFeed from "../components/HomePostFeed.astro";
import Omikuji from "../components/Omikuji.astro";
---

<Layout
  title="Sharing Life & Tech"
  description="ยินดีต้อนรับสู่ Shiori 栞 - บันทึกเรื่องราวชีวิต ฮาวทู รีวิว และเทคโนโลยีมั่วๆ ที่น่าสนใจ"
  type="website"
>
  {/* Editorial Hero Section */}
  <section class="relative pt-16 pb-14 md:pt-28 md:pb-24 overflow-hidden">
    <div
      class="container relative z-10 text-center max-w-[840px] mx-auto reveal"
    >
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary text-xs font-semibold tracking-wider mb-6 border border-primary/20"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        <span>栞 SHIORI JOURNAL</span>
      </div>
      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-extrabold mb-6 tracking-tight leading-[1.15] text-text text-balance"
      >
        Sharing Life through <span class="text-primary font-serif italic"
          >Words</span
        > & Stories
      </h1>
      <p
        class="text-base md:text-lg text-text-muted mb-10 max-w-[560px] mx-auto leading-relaxed stagger-1 reveal"
      >
        รวมฮาวทู รีวิวโน่นนี่ แล้วก็บันทึกมั่วๆ เกี่ยวกับเรื่องราวในชีวิต
      </p>
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center max-w-[340px] sm:max-w-none mx-auto stagger-2 reveal"
      >
        <a
          href="/blog"
          class="py-3.5 px-8 rounded-full font-semibold bg-primary text-white transition-all duration-300 hover:bg-secondary hover:-translate-y-0.5 shadow-[0_4px_16px_rgba(188,56,56,0.25)] no-underline flex items-center justify-center gap-2"
        >
          <span>เปิดอ่านบันทึกทั้งหมด</span>
          <span>→</span>
        </a>
        <a
          href="/about"
          class="py-3.5 px-8 rounded-full font-semibold bg-surface border border-border text-text transition-all duration-300 hover:border-primary/40 hover:text-primary hover:-translate-y-0.5 no-underline flex items-center justify-center"
        >
          เกี่ยวกับผู้เขียน
        </a>
      </div>
    </div>
  </section>

  {/* Post Cards & Feed Section with Bento Grid Switcher */}
  <section id="featured" class="py-12 md:py-16">
    <div class="container">
      <HomePostFeed posts={posts} />
    </div>
  </section>

  {/* Authentic Japanese Omikuji Section */}
  <section class="mb-16 md:mb-24">
    <div class="container">
      <Omikuji />
    </div>
  </section>
</Layout>
