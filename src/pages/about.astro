---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout
  title="เกี่ยวกับผม"
  description="ทำความรู้จักกับ Shiori ผู้สร้างสรรค์บล็อกแห่งนี้"
>
  <div class="relative overflow-hidden">
    <!-- Background Accents -->
    <div
      class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[120px] -z-10 animate-pulse-slow"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[120px] -z-10"
    >
    </div>

    <section
      class="container min-h-[90vh] flex flex-col md:flex-row items-center justify-center gap-12 md:gap-24 py-20 relative z-10"
    >
      <!-- Left: Image Section -->
      <div class="w-full md:w-1/2 flex justify-center md:justify-end reveal">
        <div class="relative group cursor-pointer">
          <!-- Decorative Elements behind image -->
          <div
            class="absolute inset-0 bg-linear-to-tr from-primary to-blue-500 rounded-[2.5rem] rotate-6 scale-95 opacity-70 group-hover:rotate-12 group-hover:scale-105 transition-all duration-700 blur-xl"
          >
          </div>

          <div
            class="relative w-[280px] h-[350px] md:w-[380px] md:h-[480px] rounded-2xl overflow-hidden card-editorial border border-border shadow-md transition-transform duration-700 group-hover:scale-[1.02] group-hover:-translate-y-1"
          >
            <Image
              src="/image.png"
              alt="Shiori Profile"
              width={800}
              height={1000}
              class="w-full h-full object-cover transition-all duration-700 md:scale-105"
            />

            <!-- Overlay Gradient -->
            <div
              class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-60"
            >
            </div>
          </div>

          <!-- Floating Badge -->
          <div
            class="absolute -bottom-4 -right-4 md:bottom-8 md:-right-8 bg-surface py-4 px-6 rounded-2xl border border-border shadow-[0_10px_30px_rgba(0,0,0,0.1)] flex flex-col items-center gap-0.5 animate-floating z-20"
          >
            <span class="text-2xl md:text-3xl font-black text-primary">AI</span>
            <span
              class="text-[0.65rem] md:text-xs font-bold uppercase tracking-[0.2em] text-text-muted"
              >Engineer</span
            >
          </div>
        </div>
      </div>

      <!-- Right: Content Section -->
      <div
        class="w-full md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left space-y-6"
      >
        <header class="reveal stagger-1">
          <div class="inline-flex items-center gap-2 mb-3">
            <span class="paper-tag text-xs">Nice to meet you</span>
          </div>
          <h1
            class="text-4xl md:text-6xl font-extrabold leading-none text-text mb-4"
          >
            สวัสดีครับ
          </h1>
        </header>

        <div
          class="space-y-5 text-text-muted text-base md:text-lg leading-relaxed reveal stagger-2 font-normal max-w-xl"
        >
          <p>
            ปัจจุบันผมทำงานเป็น <span
              class="text-text font-bold decoration-primary/50 underline underline-offset-4 decoration-2"
              >AI Engineer</span
            >
          </p>
          <p>
            เว็บนี้คือ <span class="text-primary font-semibold"
              >Time Capsule</span
            > ของผม ที่รวบรวมเรื่องราว การเรียนรู้ และความทรงจำต่างๆ เอาไว้ เผื่อวันหนึ่งย้อนกลับมาอ่านจะได้เห็นการเติบโตของตัวเอง
          </p>
          <div
            class="p-6 bg-surface-subtle rounded-xl border border-border relative overflow-hidden group"
          >
            <div class="absolute top-0 left-0 w-1.5 h-full bg-primary"></div>
            <p class="text-base italic text-text relative z-10 m-0">
              "ขอบคุณทุกคนที่แวะเวียนเข้ามา และขอบคุณมากๆ
              ที่สละเวลาเข้ามาอ่านบันทึกของผมครับ"
            </p>
          </div>
        </div>

        <div
          class="flex flex-col sm:flex-row gap-4 pt-2 w-full md:w-auto reveal stagger-3"
        >
          <a
            href="/blog"
            class="group relative px-7 py-3.5 bg-primary text-white rounded-full font-semibold text-base shadow-sm transition-all hover:bg-secondary hover:-translate-y-0.5 no-underline flex items-center justify-center gap-2"
          >
            <span>Explore My Blog</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="group-hover:translate-x-1 transition-transform"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </a>

          <div
            class="flex items-center justify-center md:justify-start gap-2.5 px-5 py-3.5 bg-surface rounded-full border border-border shadow-xs"
          >
            <span class="relative flex h-2.5 w-2.5">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"
              ></span>
            </span>
            <span class="text-xs font-semibold text-text-muted"
              >Status: <span class="text-text font-bold">Building Future</span
              ></span
            >
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack / Interests Marquee -->
    <div
      class="w-full overflow-hidden py-8 opacity-60 pointer-events-none select-none border-t border-b border-border bg-surface/40"
    >
      <div
        class="flex gap-16 animate-marquee whitespace-nowrap text-2xl text-text-muted/40 font-bold uppercase tracking-widest"
      >
        AI ENGINEER • PRODUCT BUILDER • VIBE CODER • FILM ENTHUSIAST • PROBLEM
        SOLVER • STORYTELLER • RAG ARCHITECT • AI ENGINEER • PRODUCT BUILDER •
        VIBE CODER • FILM ENTHUSIAST • PROBLEM SOLVER • STORYTELLER • RAG
        ARCHITECT
      </div>
    </div>
  </div>
</Layout>

<style>
  .animate-pulse-slow {
    animation: pulse 8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes floating {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  .animate-floating {
    animation: floating 4s ease-in-out infinite;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
</style>
