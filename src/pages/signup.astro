---
import Layout from "../layouts/Layout.astro";
import { SignIn } from "auth-astro/components";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);
if (session) {
  return Astro.redirect("/");
}
---

<Layout title="ลงทะเบียน">
  <div
    class="min-h-screen flex items-center justify-center bg-bg p-4 relative overflow-hidden"
  >
    <div
      class="login-card bg-surface p-8 md:p-10 rounded-2xl shadow-[0_12px_40px_rgba(0,0,0,0.15)] w-full max-w-[480px] z-[2] border border-border animate-slide-up"
    >
      <div class="flex justify-center mb-4">
        <span class="hanko-stamp text-sm">栞</span>
      </div>
      <h1
        class="text-2xl md:text-3xl font-extrabold text-text mb-2 text-center tracking-tight"
      >
        สร้างบัญชีใหม่
      </h1>
      <p class="text-text-muted text-center mb-8 text-sm leading-relaxed">
        กรอกข้อมูลเพื่อเริ่มต้นใช้งาน Shiori
      </p>

      <form method="POST" class="login-form flex flex-col gap-5">
        <div class="flex flex-col gap-1.5">
          <label for="name" class="text-xs font-semibold text-text ml-1"
            >ชื่อที่แสดง</label
          >
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Username ของคุณ"
            required
            class="py-3 px-4 bg-surface-subtle border border-border rounded-xl text-sm md:text-base text-text outline-none transition-all duration-300 focus:bg-surface focus:border-primary/50 focus:ring-2 focus:ring-primary/10 placeholder:text-text-subtle"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-xs font-semibold text-text ml-1"
            >อีเมล</label
          >
          <input
            type="email"
            id="email"
            name="email"
            placeholder="name@example.com"
            required
            class="py-3 px-4 bg-surface-subtle border border-border rounded-xl text-sm md:text-base text-text outline-none transition-all duration-300 focus:bg-surface focus:border-primary/50 focus:ring-2 focus:ring-primary/10 placeholder:text-text-subtle"
          />
          <p
            class="text-[#dc2626] text-xs mt-1 empty:hidden"
            id="email-error"
          >
          </p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label
            for="password"
            class="text-xs font-semibold text-text ml-1">รหัสผ่าน</label
          >
          <input
            type="password"
            id="password"
            name="password"
            placeholder="ตั้งรหัสผ่าน (อย่างน้อย 8 ตัวอักษร)"
            minlength="8"
            required
            class="py-3 px-4 bg-surface-subtle border border-border rounded-xl text-sm md:text-base text-text outline-none transition-all duration-300 focus:bg-surface focus:border-primary/50 focus:ring-2 focus:ring-primary/10 placeholder:text-text-subtle"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label
            for="confirm-password"
            class="text-xs font-semibold text-text ml-1"
            >ยืนยันรหัสผ่าน</label
          >
          <input
            type="password"
            id="confirm-password"
            name="confirm-password"
            placeholder="กรอกรหัสผ่านอีกครั้ง"
            minlength="8"
            required
            class="py-3 px-4 bg-surface-subtle border border-border rounded-xl text-sm md:text-base text-text outline-none transition-all duration-300 focus:bg-surface focus:border-primary/50 focus:ring-2 focus:ring-primary/10 placeholder:text-text-subtle"
          />
          <p
            class="text-[#dc2626] text-xs mt-1 empty:hidden"
            id="password-error"
          >
          </p>
        </div>

        <button
          type="submit"
          class="bg-primary text-white py-3.5 rounded-xl text-base font-semibold transition-all duration-300 mt-2 shadow-[0_2px_10px_rgba(188,56,56,0.25)] hover:bg-secondary hover:-translate-y-0.5 cursor-pointer disabled:opacity-70 disabled:cursor-not-allowed"
          id="submit-btn">ลงทะเบียน</button
        >
      </form>

      <div
        class="flex items-center gap-3 my-6 text-text-muted text-xs font-medium before:content-[''] before:flex-1 before:h-px before:bg-border after:content-[''] after:flex-1 after:h-px after:bg-border"
      >
        <span class="px-2">หรือดำเนินการต่อด้วย</span>
      </div>

      <SignIn
        provider="google"
        class="flex items-center justify-center gap-3 w-full py-3 bg-surface rounded-xl text-sm font-semibold text-text border border-border transition-all duration-200 hover:bg-surface-subtle hover:-translate-y-0.5 shadow-xs cursor-pointer"
        options={{ callbackUrl: "/" }}
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            fill="#4285F4"></path>
          <path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path>
          <path
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            fill="#FBBC05"></path>
          <path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            fill="#EA4335"></path>
        </svg>
        <span>Google Account</span>
      </SignIn>

      <p class="text-center mt-6 text-sm text-text-muted">
        มีบัญชีอยู่แล้ว? <a
          href="/login"
          class="text-primary font-semibold no-underline hover:underline transition-colors"
          >เข้าสู่ระบบ</a
        >
      </p>
    </div>
  </div>

  <style>
    @keyframes slide-up {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-slide-up {
      animation: slide-up 0.6s ease-out;
    }
  </style>

  <script>
    import toast from "react-hot-toast";

    function setupSignupForm() {
      const form = document.querySelector(".login-form") as HTMLFormElement;
      if (!form || form.dataset.initialized === "true") return;
      form.dataset.initialized = "true";

      const passwordInput = document.getElementById(
        "password",
      ) as HTMLInputElement;
      const confirmPasswordInput = document.getElementById(
        "confirm-password",
      ) as HTMLInputElement;
      const emailInput = document.getElementById("email") as HTMLInputElement;
      const passwordError = document.getElementById("password-error");
      const emailError = document.getElementById("email-error");

      function validatePassword() {
        if (!passwordInput || !confirmPasswordInput) return;
        if (passwordInput.value !== confirmPasswordInput.value) {
          if (passwordError) passwordError.textContent = "รหัสผ่านไม่ตรงกัน";
          confirmPasswordInput.setCustomValidity("รหัสผ่านไม่ตรงกัน");
        } else {
          if (passwordError) passwordError.textContent = "";
          confirmPasswordInput.setCustomValidity("");
        }
      }

      function validateEmail() {
        if (!emailInput) return;
        if (emailInput.validity.typeMismatch) {
          if (emailError) emailError.textContent = "รูปแบบอีเมลไม่ถูกต้อง";
        } else {
          if (emailError) emailError.textContent = "";
        }
      }

      passwordInput?.addEventListener("input", validatePassword);
      confirmPasswordInput?.addEventListener("input", validatePassword);
      emailInput?.addEventListener("input", validateEmail);

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        e.stopPropagation();

        validatePassword();
        if (!form.checkValidity()) return;

        const formData = new FormData(form);
        const submitBtn = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;

        try {
          submitBtn.disabled = true;
          submitBtn.textContent = "กำลังลงทะเบียน...";

          const res = await fetch("/api/auth/register", {
            method: "POST",
            body: formData,
          });

          const data = await res.json();

          if (data.success) {
            toast.success("ลงทะเบียนสำเร็จ! กรุณาเข้าสู่ระบบ", {
              duration: 4000,
              position: "top-center",
            });
            setTimeout(() => {
              window.location.href = "/login";
            }, 1500);
          } else {
            toast.error(data.message || "การลงทะเบียนล้มเหลว", {
              position: "top-center",
            });
            submitBtn.disabled = false;
            submitBtn.textContent = "ลงทะเบียน";
          }
        } catch (error) {
          toast.error("เกิดข้อผิดพลาดในการเชื่อมต่อ", {
            position: "top-center",
          });
          submitBtn.disabled = false;
          submitBtn.textContent = "ลงทะเบียน";
        }
      });
    }

    document.addEventListener("astro:page-load", setupSignupForm);
    setupSignupForm();
  </script>
</Layout>
